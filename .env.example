# Spring imports this file as Java properties. Copy to .env; never commit .env.
# Use KEY=value without export or surrounding quotes. Keep account numbers as digits.
# HMAC secret: use a random hexadecimal value from your local password manager/SePay.
# Filling these fields does not enable a webhook, scheduler or payout.

# Shared receiving bank: six-digit BIN and 1-19 digit account number, preserving leading zeros.
CARRENT_SEPAY_BANK_BIN=
# SePay gateway name; TPBank uses BIN 970423. Change both fields for another bank.
CARRENT_SEPAY_GATEWAY=TPBank
CARRENT_SEPAY_ACCOUNT_NUMBER=
CARRENT_SEPAY_WEBHOOK_SECRET=

# CarRent users from YOUR database, not SePay account or bank IDs.
# All profiles use these IDs for checkout approval; enable collection separately.
CARRENT_SEPAY_OWNER_ID=
CARRENT_SEPAY_ADMIN_ID=

# HTTPS origin only, without a webhook path. Use your own ngrok domain.
CARRENT_PUBLIC_BASE_URL=

# Optional for start.bat: ngrok authtoken from your OWN dashboard.
# Leave blank if ngrok is already configured on this Windows account.
# The launcher passes this to the child environment, never a command-line argument.
CARRENT_NGROK_AUTHTOKEN=

# payOS KENH CHI credentials. Never use payment-link credentials here.
CARRENT_PAYOS_OWNER_CLIENT_ID=
CARRENT_PAYOS_OWNER_API_KEY=
CARRENT_PAYOS_OWNER_CHECKSUM_KEY=
CARRENT_PAYOS_ADMIN_CLIENT_ID=
CARRENT_PAYOS_ADMIN_API_KEY=
CARRENT_PAYOS_ADMIN_CHECKSUM_KEY=
# Optional: blank IDs fall back to the matching CARRENT_SEPAY_*_ID above.
CARRENT_PAYOS_OWNER_ID=
CARRENT_PAYOS_ADMIN_ID=

# Separate VietQR /v2/lookup entitlement and credentials, never payout credentials.
# Keep disabled until the provider confirms this account may use the lookup endpoint.
CARRENT_REFUND_LOOKUP_ENABLED=false
CARRENT_REFUND_LOOKUP_CLIENT_ID=
CARRENT_REFUND_LOOKUP_API_KEY=

# Only for the explicit refund-lookup-check profile; use a known, authorized destination.
# These are private values. The diagnostic prints VERIFIED only, never the name/account.
CARRENT_REFUND_LOOKUP_CHECK_CHANNEL_ID=
CARRENT_REFUND_LOOKUP_CHECK_BANK_BIN=
CARRENT_REFUND_LOOKUP_CHECK_ACCOUNT_NUMBER=
CARRENT_REFUND_LOOKUP_CHECK_EXPECTED_NAME=
